<?xml version="1.0" encoding="utf-8"?>
<!--
    The blocking screen. Plain Views rather than Compose: a ComposeView added through
    WindowManager needs a manually supplied lifecycle / saved-state owner or it crashes at
    runtime. Colours are hardcoded because this is inflated from a Service, not a themed Activity.

    clickable="true" on the root is what swallows taps so they never reach Shorts underneath.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F50B0B0F"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="40dp">

        <!-- Accent dot, echoing the "over budget" colour from the app's usage ring. -->
        <View
            android:layout_width="56dp"
            android:layout_height="6dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/overlay_accent_bar" />

        <TextView
            android:id="@+id/overlay_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="-0.02"
            android:text="@string/overlay_title"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlay_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:textColor="#A9A8BC"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
