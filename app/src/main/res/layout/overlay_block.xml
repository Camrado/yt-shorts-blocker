<?xml version="1.0" encoding="utf-8"?>
<!--
    The blocking screen. Plain Views rather than Compose: a ComposeView added through
    WindowManager needs a manually supplied lifecycle / saved-state owner or it crashes at
    runtime, and this screen is three widgets. Colours are hardcoded because this view is
    inflated from a Service, not from a themed Activity.

    clickable="true" on the root is what swallows taps so they never reach Shorts underneath.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F20B0B0F"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <TextView
            android:id="@+id/overlay_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overlay_title"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlay_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="#D0D0D8"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
